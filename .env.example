DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_HOST=localhost
# Hébergeur (Railway) : une seule adresse, prioritaire sur POSTGRES_* — DATABASE_URL=postgresql://user:mdp@hôte:5432/base


# Adresse publique du front (liens des e-mails) et envoi d'e-mails (mentions, invitations, résumé du matin).
# Sans réglage, les e-mails s'affichent dans la console du serveur : rien n'est envoyé.
SITE_URL=http://localhost:5173
# Railway (SMTP sortant bloqué) : EMAIL_BACKEND=accounts.resend_backend.ResendEmailBackend + RESEND_API_KEY=re_…
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=TaskFlow <no-reply@example.com>

# Limites de débit (valeurs par défaut) : LOGIN_RATE=10/min  REGISTER_RATE=10/hour  CHAT_RATE=60/min  ACCOUNT_RATE=10/hour
# Dossier des pièces jointes : MEDIA_ROOT=/data/media
