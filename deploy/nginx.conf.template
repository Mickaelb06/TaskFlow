# Image unique : le front est servi ici, /api et /health/ vont vers gunicorn (127.0.0.1:8000).
server {
  listen ${PORT};
  root /usr/share/nginx/html;
  index index.html;
  access_log /dev/stdout;
  error_log /dev/stderr warn;

  client_max_body_size 20m;  # pièces jointes de la messagerie (5 Mo par fichier, 3 par message)
  location = /sw.js { add_header Cache-Control "no-cache"; }
  location /api/ {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
  location = /health/ { proxy_pass http://127.0.0.1:8000; proxy_set_header Host $host; }
  location / {
    try_files $uri $uri/ /index.html;
  }
}
